<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:DanchiManager.Converters"
                    xmlns:vm="clr-namespace:DanchiManager.ViewModels">
  <c:VacancyToGlyphConverter x:Key="VacancyGlyph"/>
  <c:BoolToVisibilityConverter x:Key="BoolVis"/>
  <c:BoolToVisibilityConverter x:Key="BoolVisInv" Invert="True"/>
  <c:FloorHeaderConverter x:Key="FloorHeader"/>
  <c:EnumEqualsConverter x:Key="EnumEq"/>
  <c:InverseBoolConverter x:Key="NotBool"/>
  <c:NonEmptyToVisibilityConverter x:Key="NonEmptyVis"/>
  <c:ScaleConverter x:Key="Scale"/>

  <Color x:Key="FaceColor">#ECE9D8</Color>
  <Color x:Key="FrameColor">#D4D0C8</Color>
  <Color x:Key="TitleStart">#0A246A</Color>
  <Color x:Key="TitleEnd">#A6CAF0</Color>
  <Color x:Key="FieldColor">#FFFFC0</Color>
  <SolidColorBrush x:Key="FaceBrush" Color="#ECE9D8"/>
  <SolidColorBrush x:Key="InkBrush" Color="#1A1A1A"/>
  <SolidColorBrush x:Key="FieldBrush" Color="#FFFFC0"/>
  <SolidColorBrush x:Key="VacantBrush" Color="#20A8B8"/>
  <SolidColorBrush x:Key="HospitalBrush" Color="#C04060"/>

  <LinearGradientBrush x:Key="TitleBarBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#0A246A" Offset="0"/>
    <GradientStop Color="#A6CAF0" Offset="1"/>
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="BtnFace" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFFFFF" Offset="0"/>
    <GradientStop Color="#D8D4C4" Offset="0.48"/>
    <GradientStop Color="#C8C4B4" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="BtnGold" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFE060" Offset="0"/>
    <GradientStop Color="#E0A010" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="BtnOrange" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFC040" Offset="0"/>
    <GradientStop Color="#E07010" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="BtnGreen" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#90E050" Offset="0"/>
    <GradientStop Color="#308018" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="BtnExit" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFD060" Offset="0"/>
    <GradientStop Color="#C06010" Offset="1"/>
  </LinearGradientBrush>

  <Style TargetType="Window">
    <Setter Property="Icon" Value="pack://application:,,,/DanchiManager;component/danchimanger.ico"/>
    <Setter Property="FontFamily" Value="Yu Gothic UI, Meiryo UI, Meiryo"/>
    <Setter Property="FontSize" Value="{Binding FontSize, Source={x:Static vm:UiSettings.Current}}"/>
    <Setter Property="Background" Value="{StaticResource FaceBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
  </Style>

  <Style x:Key="DialogHeading" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{Binding FontSize, Source={x:Static vm:UiSettings.Current}, Converter={StaticResource Scale}, ConverterParameter=1.5}"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style x:Key="BevelBorder" TargetType="Border">
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="BorderBrush">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#FFFFFF" Offset="0"/>
          <GradientStop Color="#808080" Offset="1"/>
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <Style x:Key="WinButton" TargetType="Button">
    <Setter Property="Foreground" Value="#1A1A1A"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="10,4"/>
    <Setter Property="Margin" Value="2"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{StaticResource BtnFace}" BorderBrush="#6A6A6A" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
            <Border.Effect>
              <DropShadowEffect BlurRadius="2" ShadowDepth="1" Opacity="0.25"/>
            </Border.Effect>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="#2A5A9A"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#C8C4B4"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="GoldButton" TargetType="Button" BasedOn="{StaticResource WinButton}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{StaticResource BtnGold}" BorderBrush="#8A6010" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="OrangeButton" TargetType="Button" BasedOn="{StaticResource WinButton}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{StaticResource BtnOrange}" BorderBrush="#8A4010" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="GreenButton" TargetType="Button" BasedOn="{StaticResource WinButton}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{StaticResource BtnGreen}" BorderBrush="#206010" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ExitButton" TargetType="Button" BasedOn="{StaticResource WinButton}">
    <Setter Property="FontSize" Value="{Binding FontSize, Source={x:Static vm:UiSettings.Current}, Converter={StaticResource Scale}, ConverterParameter=1.25}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{StaticResource BtnExit}" BorderBrush="#8A4010" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SizePickButton" TargetType="Button" BasedOn="{StaticResource WinButton}">
    <Setter Property="Padding" Value="4,8"/>
    <Setter Property="Margin" Value="1"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
    <Setter Property="Padding" Value="6,5"/>
    <Setter Property="BorderBrush" Value="#808080"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontSize" Value="{Binding FontSize, Source={x:Static vm:UiSettings.Current}}"/>
    <Setter Property="MinHeight" Value="32"/>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
    <Setter Property="FontSize" Value="{Binding FontSize, Source={x:Static vm:UiSettings.Current}}"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="MinHeight" Value="40"/>
  </Style>
  <Style TargetType="ListView">
    <Setter Property="FontSize" Value="{Binding FontSize, Source={x:Static vm:UiSettings.Current}}"/>
  </Style>
  <Style TargetType="ListBox">
    <Setter Property="FontSize" Value="{Binding FontSize, Source={x:Static vm:UiSettings.Current}}"/>
  </Style>
  <Style TargetType="ListViewItem">
    <Setter Property="FontSize" Value="{Binding FontSize, Source={x:Static vm:UiSettings.Current}}"/>
    <Setter Property="MinHeight" Value="{Binding ListRowHeight, Source={x:Static vm:UiSettings.Current}}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Padding" Value="4,2"/>
  </Style>
  <Style TargetType="GridViewColumnHeader">
    <Setter Property="FontSize" Value="{Binding FontSize, Source={x:Static vm:UiSettings.Current}}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="8,6"/>
  </Style>
  <Style TargetType="RadioButton">
    <Setter Property="FontSize" Value="{Binding FontSize, Source={x:Static vm:UiSettings.Current}}"/>
    <Setter Property="Margin" Value="0,3"/>
  </Style>
  <Style TargetType="CheckBox">
    <Setter Property="FontSize" Value="{Binding FontSize, Source={x:Static vm:UiSettings.Current}}"/>
    <Setter Property="Margin" Value="0,3"/>
  </Style>
  <Style TargetType="Label">
    <Setter Property="FontSize" Value="{Binding FontSize, Source={x:Static vm:UiSettings.Current}}"/>
  </Style>
</ResourceDictionary>
