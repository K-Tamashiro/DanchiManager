<Window x:Class="DanchiManager.Views.RoomEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DanchiManager.ViewModels"
        xmlns:v="clr-namespace:DanchiManager.Views"
        Title="{Binding BuildingTitle}"
        Height="660" Width="980"
        MinHeight="640" MinWidth="860"
        ResizeMode="CanResize">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Style="{StaticResource GoldButton}" Content="会費" Command="{Binding OpenFeesCommand}" Width="80"/>
      <Button Style="{StaticResource WinButton}" Content="登録" Command="{Binding SaveCommand}" Width="90"/>
      <Button Style="{StaticResource OrangeButton}" Content="削除して空室" Command="{Binding ClearCommand}" Width="110"/>
      <Button Style="{StaticResource WinButton}" Content="閉じる" Command="{Binding CancelCommand}" Width="80" IsCancel="True"/>
    </StackPanel>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="270"/>
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource BevelBorder}" Margin="0,0,12,12" Background="#F7F4E8" Padding="10">
        <StackPanel>
          <Border Background="#DCEBFA" BorderBrush="#7A9CBD" BorderThickness="1"
                  CornerRadius="4" Padding="10,8" Margin="0,0,0,12">
            <TextBlock Text="{Binding Draft.RoomNo, StringFormat={}{0} 号室}" FontWeight="Bold"
                       Foreground="#17365D" TextAlignment="Center" HorizontalAlignment="Stretch"
                       FontSize="{Binding FontSize, Source={x:Static vm:UiSettings.Current}, Converter={StaticResource Scale}, ConverterParameter=1.4}"/>
          </Border>
          <TextBlock Text="状態" FontWeight="Bold"/>
          <RadioButton Content="空室" GroupName="Vac"
                       IsChecked="{Binding Draft.Vacancy, Converter={StaticResource EnumEq}, ConverterParameter=Vacant}"/>
          <RadioButton Content="入院" GroupName="Vac"
                       IsChecked="{Binding Draft.Vacancy, Converter={StaticResource EnumEq}, ConverterParameter=Hospital}"/>
          <RadioButton Content="通常" GroupName="Vac"
                       IsChecked="{Binding Draft.Vacancy, Converter={StaticResource EnumEq}, ConverterParameter=Occupied}"/>
          <TextBlock Text="性別" FontWeight="Bold" Margin="0,10,0,0"/>
          <RadioButton Content="男性" GroupName="Gen"
                       IsChecked="{Binding Draft.Gender, Converter={StaticResource EnumEq}, ConverterParameter=Male}"/>
          <RadioButton Content="女性" GroupName="Gen"
                       IsChecked="{Binding Draft.Gender, Converter={StaticResource EnumEq}, ConverterParameter=Female}"/>
          <RadioButton Content="未設定" GroupName="Gen"
                       IsChecked="{Binding Draft.Gender, Converter={StaticResource EnumEq}, ConverterParameter=Unset}"/>
          <CheckBox Content="会員" IsChecked="{Binding Draft.Member}" Margin="0,12,0,0"/>
        </StackPanel>
      </Border>

      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock Text="氏名"/>
          <TextBox x:Name="NameBox" TabIndex="1" Text="{Binding Draft.Name, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="フリガナ（漢字を確定すると自動）" Margin="0,8,0,0"/>
          <TextBox x:Name="FuriganaBox" TabIndex="2" Text="{Binding Draft.Furigana, UpdateSourceTrigger=PropertyChanged}"/>
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="人数"/>
              <TextBox x:Name="PeopleBox" TabIndex="3" Text="{Binding Draft.People, UpdateSourceTrigger=PropertyChanged}"
                       FontWeight="Bold" MinHeight="48" TextAlignment="Right" VerticalContentAlignment="Center" Padding="8,4" FontSize="{Binding FontSize, Source={x:Static vm:UiSettings.Current}, Converter={StaticResource Scale}, ConverterParameter=1.5}" GotFocus="Count_GotFocus" Tag="人数"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="6,0">
              <TextBlock Text="バイク"/>
              <TextBox x:Name="BikesBox" TabIndex="4" Text="{Binding Draft.Bikes, UpdateSourceTrigger=PropertyChanged}"
                       FontWeight="Bold" MinHeight="48" TextAlignment="Right" VerticalContentAlignment="Center" Padding="8,4" FontSize="{Binding FontSize, Source={x:Static vm:UiSettings.Current}, Converter={StaticResource Scale}, ConverterParameter=1.5}" GotFocus="Count_GotFocus" Tag="バイク"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="自転車"/>
              <TextBox x:Name="BicyclesBox" TabIndex="5" Text="{Binding Draft.Bicycles, UpdateSourceTrigger=PropertyChanged}"
                       FontWeight="Bold" MinHeight="48" TextAlignment="Right" VerticalContentAlignment="Center" Padding="8,4" FontSize="{Binding FontSize, Source={x:Static vm:UiSettings.Current}, Converter={StaticResource Scale}, ConverterParameter=1.5}" GotFocus="Count_GotFocus" Tag="自転車"/>
            </StackPanel>
          </Grid>
          <TextBlock Text="電話" Margin="0,8,0,0"/>
          <TextBox x:Name="PhoneBox" TabIndex="6" Text="{Binding Draft.Phone, UpdateSourceTrigger=PropertyChanged}"
                   FontWeight="Bold" MinHeight="48" VerticalContentAlignment="Center" Padding="8,4" FontSize="{Binding FontSize, Source={x:Static vm:UiSettings.Current}, Converter={StaticResource Scale}, ConverterParameter=1.5}" GotFocus="Phone_GotFocus"/>
          <WrapPanel Margin="0,6,0,0">
            <Button Style="{StaticResource WinButton}" Content="{Binding PhonePrefix1}" Tag="{Binding PhonePrefix1}"
                    Visibility="{Binding HasPhonePrefix1, Converter={StaticResource BoolVis}}"
                    Click="PhonePrefix_Click" Padding="12,8" FontWeight="Bold"/>
            <Button Style="{StaticResource WinButton}" Content="{Binding PhonePrefix2}" Tag="{Binding PhonePrefix2}"
                    Visibility="{Binding HasPhonePrefix2, Converter={StaticResource BoolVis}}"
                    Click="PhonePrefix_Click" Padding="12,8" FontWeight="Bold"/>
            <Button Style="{StaticResource WinButton}" Content="{Binding PhonePrefix3}" Tag="{Binding PhonePrefix3}"
                    Visibility="{Binding HasPhonePrefix3, Converter={StaticResource BoolVis}}"
                    Click="PhonePrefix_Click" Padding="12,8" FontWeight="Bold"/>
            <Button Style="{StaticResource WinButton}" Content="{Binding PhonePrefix4}" Tag="{Binding PhonePrefix4}"
                    Visibility="{Binding HasPhonePrefix4, Converter={StaticResource BoolVis}}"
                    Click="PhonePrefix_Click" Padding="12,8" FontWeight="Bold"/>
            <Button Style="{StaticResource WinButton}" Content="{Binding PhonePrefix5}" Tag="{Binding PhonePrefix5}"
                    Visibility="{Binding HasPhonePrefix5, Converter={StaticResource BoolVis}}"
                    Click="PhonePrefix_Click" Padding="12,8" FontWeight="Bold"/>
          </WrapPanel>
          <TextBlock Text="備考" Margin="0,8,0,0"/>
          <TextBox x:Name="NoteBox" TabIndex="7" Text="{Binding Draft.Note, UpdateSourceTrigger=PropertyChanged}" Height="100" TextWrapping="Wrap" AcceptsReturn="True"/>
          <ItemsControl ItemsSource="{Binding NoteButtons}" Margin="0,4,0,8" Height="96">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="5" Rows="2"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource WinButton}" Tag="{Binding}"
                        Click="NoteButton_Click" Padding="3,4" FontWeight="Bold">
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"/>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <DockPanel Grid.Column="2" Margin="0,0,0,12" VerticalAlignment="Top">
        <TextBlock DockPanel.Dock="Top" Text="数字入力" FontWeight="Bold" FontSize="{Binding FontSize, Source={x:Static vm:UiSettings.Current}, Converter={StaticResource Scale}, ConverterParameter=1.5}"/>
        <TextBlock x:Name="TargetCaption" DockPanel.Dock="Top" Text="数字欄を選んでください" Margin="0,4,0,8" FontWeight="Bold" Foreground="#102080" TextWrapping="Wrap" FontSize="{Binding FontSize, Source={x:Static vm:UiSettings.Current}, Converter={StaticResource Scale}, ConverterParameter=1.25}"/>
        <v:NumberPicker x:Name="Picker"/>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
