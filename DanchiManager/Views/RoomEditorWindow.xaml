<Window x:Class="DanchiManager.Views.RoomEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DanchiManager.ViewModels"
        Title="{Binding BuildingTitle}"
        Height="600" Width="640"
        ResizeMode="NoResize">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Style="{StaticResource GoldButton}" Content="会費" Command="{Binding OpenFeesCommand}" Width="80"/>
      <Button Style="{StaticResource WinButton}" Content="登録" Command="{Binding SaveCommand}" Width="90" IsDefault="True"/>
      <Button Style="{StaticResource OrangeButton}" Content="削除して空室" Command="{Binding ClearCommand}" Width="110"/>
      <Button Style="{StaticResource WinButton}" Content="閉じる" Command="{Binding CancelCommand}" Width="80" IsCancel="True"/>
    </StackPanel>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource BevelBorder}" Margin="0,0,12,12" Background="#F7F4E8" Padding="10">
        <StackPanel>
          <Border Background="#DCEBFA" BorderBrush="#7A9CBD" BorderThickness="1"
                  CornerRadius="4" Padding="10,8" Margin="0,0,0,12">
            <TextBlock Text="{Binding Draft.RoomNo, StringFormat={}{0} 号室}" FontWeight="Bold"
                       Foreground="#17365D"
                       FontSize="{Binding FontSize, Source={x:Static vm:UiSettings.Current}, Converter={StaticResource Scale}, ConverterParameter=1.4}"/>
          </Border>
          <TextBlock Text="状態" FontWeight="Bold"/>
          <RadioButton Content="空室" GroupName="Vac"
                       IsChecked="{Binding Draft.Vacancy, Converter={StaticResource EnumEq}, ConverterParameter=Vacant}"/>
          <RadioButton Content="入院" GroupName="Vac"
                       IsChecked="{Binding Draft.Vacancy, Converter={StaticResource EnumEq}, ConverterParameter=Hospital}"/>
          <RadioButton Content="通常" GroupName="Vac"
                       IsChecked="{Binding Draft.Vacancy, Converter={StaticResource EnumEq}, ConverterParameter=Occupied}"/>
          <TextBlock Text="性別" FontWeight="Bold" Margin="0,10,0,0"/>
          <RadioButton Content="男性" GroupName="Gen"
                       IsChecked="{Binding Draft.Gender, Converter={StaticResource EnumEq}, ConverterParameter=Male}"/>
          <RadioButton Content="女性" GroupName="Gen"
                       IsChecked="{Binding Draft.Gender, Converter={StaticResource EnumEq}, ConverterParameter=Female}"/>
          <RadioButton Content="未設定" GroupName="Gen"
                       IsChecked="{Binding Draft.Gender, Converter={StaticResource EnumEq}, ConverterParameter=Unset}"/>
          <CheckBox Content="会員" IsChecked="{Binding Draft.Member}" Margin="0,12,0,0"/>
        </StackPanel>
      </Border>

      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="氏名"/>
          <TextBox x:Name="NameBox" Text="{Binding Draft.Name, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="フリガナ（漢字を確定すると自動）" Margin="0,8,0,0"/>
          <TextBox Text="{Binding Draft.Furigana, UpdateSourceTrigger=PropertyChanged}"/>
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="人数"/>
              <TextBox Text="{Binding Draft.People, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="6,0">
              <TextBlock Text="バイク"/>
              <TextBox Text="{Binding Draft.Bikes, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="自転車"/>
              <TextBox Text="{Binding Draft.Bicycles, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
          </Grid>
          <TextBlock Text="電話" Margin="0,8,0,0"/>
          <TextBox Text="{Binding Draft.Phone, UpdateSourceTrigger=PropertyChanged}"/>
          <WrapPanel Margin="0,4,0,0">
            <Button Style="{StaticResource WinButton}" Content="090-" Click="PhonePrefix_Click" Tag="090-"/>
            <Button Style="{StaticResource WinButton}" Content="080-" Click="PhonePrefix_Click" Tag="080-"/>
            <Button Style="{StaticResource WinButton}" Content="075-" Click="PhonePrefix_Click" Tag="075-"/>
          </WrapPanel>
          <TextBlock Text="備考" Margin="0,8,0,0"/>
          <TextBox Text="{Binding Draft.Note, UpdateSourceTrigger=PropertyChanged}" Height="80" TextWrapping="Wrap" AcceptsReturn="True"/>
          <WrapPanel>
            <Button Style="{StaticResource WinButton}" Content="非会員" Command="{Binding AppendNoteCommand}" CommandParameter="非会員"/>
            <Button Style="{StaticResource WinButton}" Content="空家賃" Command="{Binding AppendNoteCommand}" CommandParameter="空家賃"/>
            <Button Style="{StaticResource WinButton}" Content="の息子" Command="{Binding NoteSonCommand}"/>
            <Button Style="{StaticResource WinButton}" Content="の娘" Command="{Binding NoteDaughterCommand}"/>
            <Button Style="{StaticResource WinButton}" Content="備考消去" Command="{Binding ClearNoteCommand}"/>
          </WrapPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
