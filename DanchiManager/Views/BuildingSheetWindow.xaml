<Window x:Class="DanchiManager.Views.BuildingSheetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DanchiManager.ViewModels"
        Title="{Binding Title}" Width="980" Height="900" MinHeight="480" MaxHeight="900">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Style="{StaticResource OrangeButton}" Content="印刷" Command="{Binding PrintCommand}" Width="90"/>
      <Button Style="{StaticResource WinButton}" Content="閉じる" Command="{Binding CloseCommand}" Width="80" IsCancel="True"/>
    </StackPanel>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <Button DockPanel.Dock="Left" Style="{StaticResource GoldButton}" Content="＜ 前の棟"
              Command="{Binding PrevBuildingCommand}" Padding="12,4"/>
      <Button DockPanel.Dock="Right" Style="{StaticResource GoldButton}" Content="次の棟 ＞"
              Command="{Binding NextBuildingCommand}" Padding="12,4"/>
      <TextBlock Text="{Binding Title}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </DockPanel>
    <ListView ItemsSource="{Binding Rooms}">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="号室" Width="70" DisplayMemberBinding="{Binding RoomNo}"/>
          <GridViewColumn Header="氏名" Width="140" DisplayMemberBinding="{Binding Name}"/>
          <GridViewColumn Header="電話" Width="130" DisplayMemberBinding="{Binding Phone}"/>
          <GridViewColumn Header="状態" Width="70">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Vacancy, Converter={StaticResource VacancyGlyph}}"/>
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Header="人数" Width="60" DisplayMemberBinding="{Binding People}"/>
          <GridViewColumn Header="バイク" Width="70" DisplayMemberBinding="{Binding Bikes}"/>
          <GridViewColumn Header="自転車" Width="70" DisplayMemberBinding="{Binding Bicycles}"/>
          <GridViewColumn Header="備考" Width="220" DisplayMemberBinding="{Binding Note}"/>
        </GridView>
      </ListView.View>
    </ListView>
  </DockPanel>
</Window>
