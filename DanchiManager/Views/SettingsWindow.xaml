<Window x:Class="DanchiManager.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定" Width="720" MaxHeight="900" SizeToContent="Height" ResizeMode="NoResize">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="保存" Command="{Binding SaveCommand}" Style="{StaticResource OrangeButton}" MinWidth="90" IsDefault="True"/>
      <Button Content="キャンセル" Command="{Binding CancelCommand}" Style="{StaticResource WinButton}" MinWidth="120" IsCancel="True"/>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
    <TextBlock Text="設定" Style="{StaticResource DialogHeading}" Margin="0,0,0,16"/>
    <TextBlock Text="メイン画面のタイトル"/>
    <TextBox Text="{Binding WindowTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,14"/>
    <TextBlock Text="会費封筒のタイトル"/>
    <TextBox Text="{Binding EnvelopeTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,14"/>
    <TextBlock Text="会費封筒の印刷開始月"/>
    <DockPanel Margin="0,4,0,8">
      <ComboBox ItemsSource="{Binding Months}" SelectedItem="{Binding EnvelopeStartMonth, Mode=TwoWay}"
                Width="120" HorizontalAlignment="Left">
        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat={}{0}月}"/></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
      <StackPanel Orientation="Horizontal" Margin="28,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="会費" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBox Text="{Binding MonthlyFee, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
        <TextBlock Text="円" VerticalAlignment="Center" Margin="8,0,0,0"/>
      </StackPanel>
    </DockPanel>
    <TextBlock Text="選択した月から12か月分を印刷します。" TextWrapping="Wrap"/>
    <TextBlock Text="電話番号の短縮ボタン（最大10文字、空欄は非表示）" FontWeight="Bold" Margin="0,16,0,4"/>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="36"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Text="1" VerticalAlignment="Center"/>
      <TextBox Grid.Column="1" Text="{Binding PhonePrefix1, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" Margin="0,2"/>
      <TextBlock Grid.Row="1" Text="2" VerticalAlignment="Center"/>
      <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PhonePrefix2, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" Margin="0,2"/>
      <TextBlock Grid.Row="2" Text="3" VerticalAlignment="Center"/>
      <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PhonePrefix3, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" Margin="0,2"/>
      <TextBlock Grid.Row="3" Text="4" VerticalAlignment="Center"/>
      <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding PhonePrefix4, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" Margin="0,2"/>
      <TextBlock Grid.Row="4" Text="5" VerticalAlignment="Center"/>
      <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding PhonePrefix5, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" Margin="0,2"/>
    </Grid>
    <TextBlock Text="備考ボタン（最大10文字、空欄はボタンを出しません）" FontWeight="Bold" Margin="0,16,0,4"/>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="28"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="28"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Text="1" VerticalAlignment="Center"/>
      <TextBox Grid.Column="1" Text="{Binding NoteButton1, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" Margin="0,2"/>
      <TextBlock Grid.Column="3" Text="6" VerticalAlignment="Center"/>
      <TextBox Grid.Column="4" Text="{Binding NoteButton6, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" Margin="0,2"/>
      <TextBlock Grid.Row="1" Text="2" VerticalAlignment="Center"/>
      <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NoteButton2, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" Margin="0,2"/>
      <TextBlock Grid.Row="1" Grid.Column="3" Text="7" VerticalAlignment="Center"/>
      <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding NoteButton7, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" Margin="0,2"/>
      <TextBlock Grid.Row="2" Text="3" VerticalAlignment="Center"/>
      <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding NoteButton3, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" Margin="0,2"/>
      <TextBlock Grid.Row="2" Grid.Column="3" Text="8" VerticalAlignment="Center"/>
      <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding NoteButton8, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" Margin="0,2"/>
      <TextBlock Grid.Row="3" Text="4" VerticalAlignment="Center"/>
      <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding NoteButton4, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" Margin="0,2"/>
      <TextBlock Grid.Row="3" Grid.Column="3" Text="9" VerticalAlignment="Center"/>
      <TextBox Grid.Row="3" Grid.Column="4" Text="{Binding NoteButton9, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" Margin="0,2"/>
      <TextBlock Grid.Row="4" Text="5" VerticalAlignment="Center"/>
      <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding NoteButton5, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" Margin="0,2"/>
      <TextBlock Grid.Row="4" Grid.Column="3" Text="10" VerticalAlignment="Center"/>
      <TextBox Grid.Row="4" Grid.Column="4" Text="{Binding NoteButton10, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" Margin="0,2"/>
    </Grid>
    </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
