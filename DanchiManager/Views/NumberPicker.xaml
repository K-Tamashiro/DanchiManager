<UserControl x:Class="DanchiManager.Views.NumberPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="248" Height="354" VerticalAlignment="Top">
  <UserControl.Resources>
    <Style x:Key="PadKey" TargetType="Button">
      <Setter Property="FontSize" Value="32"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin" Value="3"/>
      <Setter Property="MinHeight" Value="58"/>
      <Setter Property="Foreground" Value="#1A1A1A"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="#F7F3E6" BorderBrush="#6A6A6A" BorderThickness="1" CornerRadius="2">
              <Border.Effect>
                <DropShadowEffect BlurRadius="2" ShadowDepth="1" Opacity="0.28"/>
              </Border.Effect>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PadClear" TargetType="Button" BasedOn="{StaticResource PadKey}">
      <Setter Property="Foreground" Value="#8A2010"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="#F8D0C8" BorderBrush="#8A4010" BorderThickness="1" CornerRadius="2">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PadEnter" TargetType="Button" BasedOn="{StaticResource PadKey}">
      <Setter Property="Foreground" Value="#103010"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="#C8E8B8" BorderBrush="#206010" BorderThickness="1" CornerRadius="2">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Border Background="#E7E1D0" BorderBrush="#8A8A8A" BorderThickness="1" CornerRadius="2" Padding="6">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Button Style="{StaticResource PadKey}" Content="7" Tag="7" Click="Key_Click"/>
      <Button Grid.Column="1" Style="{StaticResource PadKey}" Content="8" Tag="8" Click="Key_Click"/>
      <Button Grid.Column="2" Style="{StaticResource PadKey}" Content="9" Tag="9" Click="Key_Click"/>
      <Button Grid.Row="1" Style="{StaticResource PadKey}" Content="4" Tag="4" Click="Key_Click"/>
      <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource PadKey}" Content="5" Tag="5" Click="Key_Click"/>
      <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource PadKey}" Content="6" Tag="6" Click="Key_Click"/>
      <Button Grid.Row="2" Style="{StaticResource PadKey}" Content="1" Tag="1" Click="Key_Click"/>
      <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource PadKey}" Content="2" Tag="2" Click="Key_Click"/>
      <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource PadKey}" Content="3" Tag="3" Click="Key_Click"/>
      <Button Grid.Row="3" Style="{StaticResource PadClear}" Content="AC" Tag="AC" Click="Key_Click" FontSize="26"/>
      <Button Grid.Row="3" Grid.Column="1" Style="{StaticResource PadKey}" Content="0" Tag="0" Click="Key_Click"/>
      <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource PadKey}" Content="-" Tag="-" Click="Key_Click"/>
      <Button Grid.Row="4" Style="{StaticResource PadClear}" Content="C" Tag="C" Click="Key_Click"/>
      <Button Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource PadEnter}" Content="ENT" Tag="ENT" Click="Key_Click"/>
    </Grid>
  </Border>
</UserControl>
