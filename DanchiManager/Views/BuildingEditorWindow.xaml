<Window x:Class="DanchiManager.Views.BuildingEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="棟編集" Height="560" Width="580" ResizeMode="NoResize">
  <DockPanel Margin="12">
    <TextBlock DockPanel.Dock="Top" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource DialogHeading}" Margin="0,0,0,8"/>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Style="{StaticResource WinButton}" Content="登録" Command="{Binding SaveCommand}" Width="90"/>
      <Button Style="{StaticResource OrangeButton}" Content="この棟を削除" Command="{Binding DeleteCommand}" Width="120"/>
      <Button Style="{StaticResource WinButton}" Content="閉じる" Command="{Binding CancelCommand}" Width="80" IsCancel="True"/>
    </StackPanel>
    <StackPanel>
      <TextBlock Text="棟名"/>
      <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
      <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="表示順"/>
          <TextBox Text="{Binding SortOrder, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="8,0">
          <TextBlock Text="階数"/>
          <TextBox Text="{Binding Levels, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="1階あたり部屋数"/>
          <TextBox Text="{Binding RoomsPerFloor, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
      </Grid>
      <CheckBox Content="4号室を飛ばす" IsChecked="{Binding Skip4}" Margin="0,8"/>
      <Button Style="{StaticResource GoldButton}" Content="階数・部屋数から番号を作り直す" Command="{Binding RebuildLayoutCommand}" HorizontalAlignment="Left"/>
      <TextBlock Text="部屋番号（1行＝1階、カンマ区切り）" Margin="0,10,0,0"/>
      <TextBox Text="{Binding CustomLayout, UpdateSourceTrigger=PropertyChanged}" Height="140"
               AcceptsReturn="True" FontFamily="Consolas" TextWrapping="Wrap"/>
    </StackPanel>
  </DockPanel>
</Window>
